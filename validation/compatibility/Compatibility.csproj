<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <TieredCompilation>false</TieredCompilation>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**</DefaultItemExcludes>
    <CodecVersion Condition="'$(CodecVersion)' == ''">local</CodecVersion>
    <DefineConstants Condition="'$(CodecVersion)' != 'local' And '$(CodecVersion)' != '3.0.0'">$(DefineConstants);LEGACY_BUFFER_API</DefineConstants>
    <DefineConstants Condition="'$(CodecVersion)' == 'local' Or '$(CodecVersion)' == '2.0.0' Or '$(CodecVersion)' == '3.0.0'">$(DefineConstants);MANAGED_BYTE_API</DefineConstants>
    <DefineConstants Condition="'$(CodecVersion)' == '1.1.0' Or '$(CodecVersion)' == '1.2.0' Or '$(CodecVersion)' == '1.2.1' Or '$(CodecVersion)' == '1.3.0' Or '$(CodecVersion)' == '1.4.0'">$(DefineConstants);SIGNED_MANAGED_ENCODE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(CodecVersion)' == 'local'">
    <ProjectReference Include="../../ReedSolomon/ReedSolomon/ReedSolomon.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(CodecVersion)' != 'local'">
    <PackageReference Include="ReedSolomon" Version="[$(CodecVersion)]" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Witteborn.ReedSolomon.ReedSolomon" Alias="Codec" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CodecVersion</_Parameter1>
      <_Parameter2>$(CodecVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
